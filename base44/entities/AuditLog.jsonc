{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "register",
        "login",
        "seat_claim",
        "bid_place",
        "bid_accept",
        "trade_settle",
        "upload",
        "comment",
        "flag",
        "price_change",
        "territory_inject",
        "territory_delete",
        "admin_grant",
        "backup_export",
        "backup_import",
        "location_set",
        "moderation_penalty",
        "moderation_remove",
        "seat_sell",
        "seat_revoke",
        "seat_transfer"
      ],
      "enumColors": [
        "blue",
        "gray",
        "green",
        "yellow",
        "purple",
        "purple",
        "blue",
        "blue",
        "red",
        "yellow",
        "pink",
        "red",
        "red",
        "gray",
        "gray",
        "green",
        "red",
        "red",
        "yellow",
        "red",
        "purple"
      ]
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "ip": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "data.actor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}