{
  "name": "OfferMessage",
  "type": "object",
  "properties": {
    "offer_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "from_admin": {
      "type": "boolean",
      "default": false
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "offer_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}